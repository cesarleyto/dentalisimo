---
const fotos = [1, 2, 3, 4];
---
<section class="galeria-section">
	{fotos.map((num) => (
		<div class="galeria-item" onclick={`document.getElementById('modal-${num}').showModal()`}>
			<img src={`/assets/images/c${num}.webp`} alt={`Instalaciones Dentalísimo ${num}`} class="hover-zoom">
		</div>
	))}

	{/* Modales para cada foto */}
	{fotos.map((num) => (
		<dialog id={`modal-${num}`} class="lightbox" onclick="this.close()">
			<img src={`/assets/images/c${num}.webp`} alt={`Instalaciones Dentalísimo ${num}`}>
			<button class="close-lightbox" onclick={`document.getElementById('modal-${num}').close()`}>✕</button>
		</dialog>
	))}
</section>

<style>
	.galeria-section {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		width: 100%;
		overflow: hidden;
	}
	.galeria-item {
		width: 100%;
		aspect-ratio: 1 / 1; /* Fotos cuadradas perfectas */
		overflow: hidden;
		cursor: pointer;
	}
	.galeria-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	
	/* Estilos del Lightbox nativo */
	.lightbox {
		margin: auto;
		border: none;
		background: transparent;
		max-width: 90vw;
		max-height: 90vh;
		overflow: visible;
	}
	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(5px);
	}
	.lightbox img {
		max-width: 100%;
		max-height: 85vh;
		border-radius: 10px;
		box-shadow: 0 0 30px rgba(0,0,0,0.5);
	}
	.close-lightbox {
		position: absolute;
		top: -40px;
		right: 0;
		background: none;
		border: none;
		color: white;
		font-size: 2rem;
		cursor: pointer;
	}

	@media (max-width: 768px) {
		.galeria-section { grid-template-columns: repeat(2, 1fr); }
	}
</style>