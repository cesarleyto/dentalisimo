        </div>
    </div>
    <div class="ubicacion-mapa">
        <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1967.7958691973797!2d-95.23279394322773!3d16.328903366072712!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85bff080ae8fffff%3A0x65f862047f5f14f0!2sDental%C3%ADsimo!5e1!3m2!1ses-419!2smx!4v1781400791911!5m2!1ses-419!2smx"
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy">
        </iframe>
    </div>
</section>

<style>
    .ubicacion-section {
        display: flex;
        min-height: 520px;
        width: 100%;
    }
    .ubicacion-datos {
        width: 50%;
        background: linear-gradient(to bottom, var(--verdeazul), var(--verdeazul-2));
        color: var(--blanco);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px;
    }
    .datos-content {
        max-width: 400px;
        width: 100%;
    }
    .datos-content h2 {
        font-size: 2.5rem;
        font-weight: 900;
        margin-bottom: 20px;
    }
    .datos-content p {
        font-size: 1.1rem;
        margin-bottom: 15px;
        line-height: 1.6;
    }
    
    .botones-contacto {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-top: 25px;
        align-items: flex-start;
    }
    .btn-contacto {
        width: fit-content;
        font-size: 0.95rem;
        padding: 12px 24px;
        justify-content: flex-start;
        display: flex;
        align-items: center;
    }

    /* Contenedor del mapa para evitar el color negro */
    .ubicacion-mapa {
        width: 50%;
        min-height: 520px;
        position: relative;
    }
    .ubicacion-mapa iframe {
        display: block;
    }

    @media (max-width: 768px) {
        .ubicacion-section { flex-direction: column; min-height: auto; }
        .ubicacion-datos { width: 100%; padding: 60px 24px; }
        .ubicacion-mapa { display: none; }
        
        .datos-content { text-align: center; display: flex; flex-direction: column; align-items: center; }
        .botones-contacto { align-items: center; width: 100%; }
        .btn-contacto { width: 100%; max-width: 340px; justify-content: center; }
    }
</style>