            <p><strong>Dirección:</strong><br>Porfirio Díaz No. 10, Barrio Laborío, Santo Domingo Tehuantepec, Oaxaca.</p>
            
            <div class="botones-contacto">
                <a href="https://wa.me/529711045697" target="_blank" class="btn-blanco btn-contacto">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:10px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
