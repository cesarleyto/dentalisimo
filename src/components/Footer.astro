<footer class="footer-dentalisimo">
	<div class="footer-content">
		<a href="/">
			<img src="/assets/logo/dentalisimo.svg" alt="Logo Dentalísimo" class="footer-logo">
		</a>
		<p>&copy; {new Date().getFullYear()} Clínica Dental Dentalísimo. Todos los derechos reservados.</p>
	</div>
</footer>

<style>
	.footer-dentalisimo {
		background-color: var(--verdeazul);
		padding: 40px 20px;
		text-align: center;
		color: var(--blanco);
	}
	.footer-logo {
		width: 200px;
		margin-bottom: 15px;
		transition: transform 0.3s ease;
	}
	.footer-logo:hover {
		transform: scale(1.1);
	}
	.footer-content p {
		font-size: 0.9rem;
		opacity: 0.8;
	}
</style>