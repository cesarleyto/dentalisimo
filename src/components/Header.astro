---
<header class="header-flotante">
    <div class="header-container">
        <div class="logo-area">
            <button id="menu-btn" class="hamburger" aria-label="Abrir menú">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
            </button>
            <a href="/" class="logo-link">
                <img src="/assets/logo/dentalisimo.svg" alt="Dentalísimo - Clínica Dental en Tehuantepec" class="logo">
            </a>
        </div>

        <nav id="nav-menu" class="nav-links">
            <button id="close-btn" class="close-btn" aria-label="Cerrar menú">✕</button>
            <a href="/#Servicios">Servicios</a>
            <a href="/#Ubicacion">Ubicación</a>
            <a href="/blog">Blog</a>
            
            <div class="action-buttons">
                <a href="https://wa.me/529711045697" target="_blank" class="btn-blanco btn-sm">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:8px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    WhatsApp
                </a>
                <a href="tel:+529711045697" class="btn-blanco btn-sm">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:8px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    Llamada
                </a>
            </div>

            <div class="social-icons">
                <a href="https://www.facebook.com/dentalisimo" target="_blank"><svg width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
                <a href="https://www.instagram.com/clinicadentalisimo" target="_blank"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
                <a href="https://www.tiktok.com/@dramayelaleyto" target="_blank"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg></a>
            </div>
        </nav>
    </div>
</header>

<style>
    .header-flotante {
        position: fixed;
        top: 20px;
        /* Nuevo método de centrado a prueba de fallos para menús fijos */
        left: 0;
        right: 0;
        margin: 0 auto;
        width: 90%;
        max-width: 1200px;
        z-index: 1000;
        background: var(--gradiente);
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        padding: 10px 30px;
    }
    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .logo-area {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .logo {
        height: 40px;
        width: auto;
    }
    .hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
    }
    .close-btn {
        display: none;
    }
    .nav-links {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .nav-links a:not(.btn-blanco):not(.social-icons a) {
        color: var(--blanco);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: opacity 0.3s;
    }
    .nav-links a:hover {
        opacity: 0.8;
    }
    .action-buttons {
        display: flex;
        gap: 10px;
    }
    .btn-sm {
        padding: 8px 16px;
        font-size: 0.85rem;
    }
    .social-icons {
        display: flex;
        gap: 10px;
        border-left: 1px solid rgba(255,255,255,0.3);
        padding-left: 20px;
    }
    .social-icons a {
        transition: transform 0.3s;
    }
    .social-icons a:hover {
        transform: scale(1.1);
    }

    @media (max-width: 992px) {
        .header-flotante {
            width: 85%;
            padding: 10px 20px;
            border-radius: 15px;
        }
        .logo {
            height: 30px;
        }
        .hamburger {
            display: block;
        }
        .nav-links {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            background: var(--gradiente);
            width: 90vw;
            height: auto;
            min-height: 70vh;
            padding: 50px 20px;
            border-radius: 30px;
            flex-direction: column;
            justify-content: center;
            align-items: center; /* Centra todo el contenido */
            gap: 25px; /* Más espacio entre enlaces */
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            z-index: 1001; /* Asegura que el modal esté por encima de todo */
        }
        .nav-links.active {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, -50%) scale(1);
        }
        .nav-links a:not(.btn-blanco):not(.social-icons a) {
            font-size: 1.5rem; /* Enlaces mucho más grandes y legibles en móvil */
        }
        .close-btn {
            display: block;
            position: absolute;
            top: 20px;
            right: 25px;
            background: none;
            border: none;
            color: white;
            font-size: 2rem;
            cursor: pointer;
        }
        .action-buttons {
            flex-direction: column;
            width: 100%;
            max-width: 250px;
            gap: 15px;
        }
        .action-buttons a {
            width: 100%;
            justify-content: center; /* Centra el icono y el texto del botón */
            padding: 12px;
            font-size: 1rem;
        }
        .social-icons {
            border-left: none;
            border-top: 1px solid rgba(255,255,255,0.3);
            padding-left: 0;
            padding-top: 25px;
            margin-top: 10px;
            width: 100%;
            max-width: 200px;
            justify-content: center; /* Centra las redes sociales */
            gap: 20px;
        }
    }
</style>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const closeBtn = document.getElementById('close-btn');
    const navMenu = document.getElementById('nav-menu');
    const links = navMenu.querySelectorAll('a');

    function toggleMenu() {
        navMenu.classList.toggle('active');
    }

    menuBtn.addEventListener('click', toggleMenu);
    closeBtn.addEventListener('click', toggleMenu);
    links.forEach(link => link.addEventListener('click', () => {
        if(window.innerWidth <= 992) toggleMenu();
    }));
</script>