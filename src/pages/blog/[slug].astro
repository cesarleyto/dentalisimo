---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Metadatos Dinámicos del MD
const title = `${post.data.title} | Dentalísimo - Clínica Dental en Tehuantepec, Oaxaca`;
const description = post.data.description;
const image = post.data.heroImage || '/og-image2.jpg';
---

<Layout title={title} description={description} image={image}>
    <Header />
    
    <main class="post-layout">
        <div class="post-hero">
            {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.title} class="post-hero-img" />}
            <div class="post-hero-content">
                <span class="categoria-tag">{post.data.category || 'Salud Dental'}</span>
                <h1>{post.data.title}</h1>
            </div>
        </div>

        <article class="post-content">
            <Content />
        </article>

        <div class="post-actions">
            <a href="https://wa.me/529711045697" target="_blank" class="btn-cta">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:8px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                Agenda vía WhatsApp
            </a>
            <a href="tel:+529711045697" class="btn-cta">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:8px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Agenda vía Llamada
            </a>
            <a href="/blog" class="btn-color">Índice del Blog</a>
        </div>

<div class="author-module">
            <div class="author-avatar">
                <img src="/assets/images/dramayelaleyto.jpg" alt="Dra. Mayela Leyto" />
            </div>
            <div class="author-info">
                <h4>Escrito y publicado por</h4>
                <h3>Dra. Mayela Leyto</h3>
                <p>Odontopedriatra - Fundadora de Dentalísimo</p>
                <div class="author-meta">
                    <p class="cedula">CED. PROF: 09994759</p>
                    
                    <div class="social-links">
                        <a href="https://facebook.com/dentalisimo" target="_blank" aria-label="Facebook">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                        </a>
                        <a href="https://instagram.com/dramayelaleyto" target="_blank" aria-label="Instagram">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                        </a>
                        <a href="https://tiktok.com/@dramayelaleyto" target="_blank" aria-label="TikTok">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <Cta />
    <Footer />
</Layout>

<style>
    .post-layout {
        padding-top: 90px;
        background: #fafafa;
    }
    
    /* Contenedor de los nuevos botones */
    .post-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
        margin: 0 auto 50px auto;
        padding: 0 20px;
        max-width: 800px;
    }

    .post-hero {
        max-width: 1000px;
        margin: 0 auto;
        position: relative;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .post-hero-img {
        width: 100%;
        height: 450px;
        object-fit: cover;
        display: block;
    }
    .post-hero-content {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 50px 40px 40px 40px;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        color: white;
    }
    .post-hero-content h1 {
        font-size: 2.8rem;
        font-weight: 900;
        line-height: 1.1;
        text-shadow: 2px 2px 5px rgba(0,0,0,0.5);
    }
    .categoria-tag {
        display: inline-block;
        background: var(--gradiente);
        color: white;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .post-content {
        max-width: 800px;
        margin: 50px auto;
        background: white;
        padding: 50px;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        font-size: 1.1rem;
        line-height: 1.8;
        color: #333;
    }
    
    .post-content :global(h2) { color: var(--verdeazul); margin-top: 40px; margin-bottom: 20px; font-weight: 800; font-size: 2rem;}
    .post-content :global(h3) { color: var(--verdeazul-2); margin-top: 30px; margin-bottom: 15px; font-weight: 700;}
    .post-content :global(p) { margin-bottom: 20px; }
    .post-content :global(ul) { margin-bottom: 20px; padding-left: 20px; }
    .post-content :global(li) { margin-bottom: 10px; }
    .post-content :global(img) { max-width: 100%; border-radius: 15px; margin: 30px 0; }

    .author-module {
        max-width: 800px;
        margin: 0 auto 80px auto;
        background: var(--gradiente);
        border-radius: 100px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 30px;
        color: white;
        box-shadow: 0 10px 25px rgba(15, 168, 189, 0.3);
    }
    .author-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 4px solid white;
        overflow: hidden;
        flex-shrink: 0;
    }
    .author-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .author-info h4 { font-size: 0.9rem; font-weight: 400; opacity: 0.9; margin-bottom: 5px; }
    .author-info h3 { font-size: 1.8rem; font-weight: 900; margin-bottom: 5px; }
    .author-info p { font-size: 1rem; margin-bottom: 5px; }
    .author-info .cedula { font-size: 0.8rem; font-weight: 600; background: rgba(255,255,255,0.2); display: inline-block; padding: 2px 10px; border-radius: 10px; }

    .author-meta {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 10px;
    }

    .social-links {
        display: flex;
        gap: 15px;
    }

    .social-links a {
        color: white;
        opacity: 0.8;
        transition: opacity 0.3s ease;
        display: flex;
    }

    .social-links a:hover {
        opacity: 1;
    }

    @media (max-width: 768px) {
        .post-hero { border-radius: 0; }
        .post-hero-img { height: 350px; }
        .post-hero-content h1 { font-size: 2rem; }
        .post-content { margin: 20px; padding: 30px 20px; }
        
        .post-actions { flex-direction: column; width: 100%; }
        .post-actions a { width: 100%; justify-content: center; }

        .author-module {
            flex-direction: column;
            border-radius: 30px;
            text-align: center;
            margin: 0 20px 60px 20px;
            padding: 30px;
        }
        .author-meta {
            flex-direction: column;
            gap: 15px;
        }
    }
</style>