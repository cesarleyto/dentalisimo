---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

// Extraemos los posteos
const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Definimos las categorías (Las 8 del servicio + Dentalísimo)
const categorias = [
    "Todos", "Dentalísimo", "Odontología Infantil", "Ortodoncia y Ortopedia", 
    "Diseño de Sonrisa", "Odontología Digital", "Limpieza y Blanqueamiento", 
    "Cirugía e Implantología", "Endodoncia", "Cirugía Estética Facial"
];

const title = "Blog | Dentalísimo - Clínica Dental en Tehuantepec, Oaxaca";
const description = "Conoce todo sobre el cuidado de tu sonrisa, tips de salud dental y tecnología de vanguardia.";
---

<Layout title={title} description={description} image="/og-image2.jpg">
    <Header />
    
    <main class="blog-main">
        <div class="blog-header">
            <h1 class="title-verdeazul">Nuestro Blog</h1>
            <p>Descubre artículos, consejos y las últimas novedades en salud dental.</p>
            
            <div class="categorias-selector">
                {categorias.map(cat => (
                    <button class={`btn-color ${cat === 'Todos' ? 'active' : ''}`} data-category={cat}>
                        {cat}
                    </button>
                ))}
            </div>
        </div>

        <div class="posts-grid" id="posts-grid">
            {posts.map((post) => (
                <article class="post-card" data-category={post.data.category || 'Dentalísimo'}>
                    <a href={`/blog/${post.id}`} class="card-link">
                        <div class="img-wrapper">
                            <span class="categoria-tag">{post.data.category || 'Dentalísimo'}</span>
                            <img src={post.data.heroImage || '/og-image2.jpg'} alt={post.data.title} class="hover-zoom">
                        </div>
                        <div class="post-info">
                            <h3>{post.data.title}</h3>
                            <p>{post.data.description}</p>
                            <span class="leer-mas">Leer más →</span>
                        </div>
                    </a>
                </article>
            ))}
        </div>
    </main>

    <Cta />
    <Footer />
</Layout>

<style>
    .blog-main { padding: 150px 20px 80px 20px; max-width: 1200px; margin: 0 auto; }
    .blog-header { text-align: center; margin-bottom: 50px; }
    .title-verdeazul { color: var(--verdeazul); font-size: 3rem; font-weight: 900; margin-bottom: 15px; }
    .categorias-selector { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
    
    /* Clase activa para botones */
    .btn-color.active { background: var(--gradiente); color: white; border: 2px solid transparent; }
    
    .posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
    
    /* El enlace que envuelve todo */
    .card-link { text-decoration: none; color: inherit; display: block; height: 100%; }
    
    .post-card { background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.08); transition: transform 0.3s ease; height: 100%; }
    .post-card:hover { transform: translateY(-5px); }

    .img-wrapper { width: 100%; height: 220px; overflow: hidden; position: relative; }
    .img-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .post-card:hover .img-wrapper img { transform: scale(1.05); /* Efecto zoom */ }

    /* Etiqueta flotante en la esquina superior izquierda */
    .categoria-tag {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 10;
        display: inline-block;
        background: var(--gradiente);
        color: white;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .post-info { padding: 25px; }
    .post-info h3 { color: var(--verdeazul); font-size: 1.3rem; margin-bottom: 10px; font-weight: 700; line-height: 1.3; }
    .post-info p { color: var(--negro); font-size: 0.95rem; margin-bottom: 15px; opacity: 0.8; }
    
    .leer-mas { color: var(--verdeazul-2); font-weight: 700; transition: color 0.3s; }
    .post-card:hover .leer-mas { color: var(--verdeazul); }

    @media (max-width: 992px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) { .posts-grid { grid-template-columns: 1fr; } .blog-main { padding-top: 120px; } }
</style>

<script>
    const buttons = document.querySelectorAll('.categorias-selector button');
    const cards = document.querySelectorAll('.post-card');

    buttons.forEach(button => {
        button.addEventListener('click', () => {
            // Actualizar botones
            buttons.forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');

            const filter = button.getAttribute('data-category');

            // Filtrar tarjetas
            cards.forEach(card => {
                const category = card.getAttribute('data-category');
                if (filter === 'Todos' || category === filter) {
                    (card as HTMLElement).style.display = 'block';
                } else {
                    (card as HTMLElement).style.display = 'none';
                }
            });
        });
    });
</script>